# PostgreSQL is the application's only database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
PORT=2001
SESSION_TTL_DAYS=7
TRUST_PROXY=false
DATABASE_POOL_MAX=10
# Set true only when the provider presents a certificate trusted by Node.js.
DATABASE_SSL=false
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_your_token_here
CRON_SECRET=generate_a_long_random_value
