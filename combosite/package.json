{
  "name": "combosite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node server/dev.js",
    "server": "node --env-file-if-exists=.env server/index.js",
    "client": "npm --prefix client run dev -- --host 0.0.0.0 --port 5173",
    "build": "npm --prefix client run build",
    "lint": "npm --prefix client run lint",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "test": "node --test",
    "healthcheck": "node scripts/health-check.js",
    "start": "npm run dev"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.0",
    "pg": "^8.22.0"
  }
}
